@model List<Ferrer_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body">

            <h5>Your cart is empty.</h5>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                Continue Shopping
            </a>

        </div>
    </div>
}
else
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.ProductName
                    </td>

                    <td>
                        ₱@item.Price
                    </td>

                    <td>

                        <form asp-action="Update" method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width: 80px; display: inline-block;" />

                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                Update
                            </button>

                        </form>

                    </td>

                    <td>
                        ₱@(item.Price * item.Quantity)
                    </td>

                    <td>

                        <a asp-action="Remove"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Remove
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <div class="card">
        <div class="card-body">

            <h4>
                Total: ₱@Model.Sum(item => item.Price * item.Quantity)
            </h4>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-secondary">
                Continue Shopping
            </a>

        </div>
    </div>
}